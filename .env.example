# Copy to .env and fill in. .env is gitignored: never commit real keys.
# Leave GEMINI_API_KEY empty to run in offline mode (rules only, no LLM answer).
GEMINI_API_KEY=

# OR: any OpenAI-compatible provider (used when GEMINI_API_KEY is empty).
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a model id ending in :free>
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# OR: Vertex AI with your gcloud login (used when GEMINI_API_KEY is empty).
# Run `gcloud auth application-default login` first. Project ID goes here only.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20

# Demo context: set server-side, never from the browser.
TRUSTLENS_DEMO_USER=arne.goossens
TRUSTLENS_DEMO_COUNTRY=BE
TRUSTLENS_AS_OF_DATE=2026-09-30

RATE_LIMIT_PER_MINUTE=20
ENABLE_API_DOCS=false
